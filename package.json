{
  "name": "linkedin-games-solver",
  "displayName": "__MSG_extensionName__",
  "version": "0.0.17",
  "description": "__MSG_extensionDescription__",
  "alias": {
    "node:module": false,
    "node:fs": false,
    "node:path": false,
    "node:os": false
  },
  "author": "Muhammed Mustafa AKŞAM <info@muhammedaksam.com.tr>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "generate:store-assets": "tsx scripts/generate-store-assets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check": "pnpm format:check && pnpm lint",
    "fix": "pnpm format && pnpm lint:fix"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.16.0",
    "plasmo": "0.90.5",
    "radix-ui": "^1.4.3",
    "react": "18.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/dom-chromium-ai": "^0.0.16",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.15",
    "prettier": "3.2.4",
    "puppeteer": "^25.0.4",
    "shadcn": "^4.8.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.3",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.59.4"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "default_locale": "en",
    "devtools_page": "tabs/devtools.html",
    "optional_host_permissions": [
      "https://*.linkedin.com/games/*"
    ],
    "permissions": [
      "activeTab",
      "storage",
      "session",
      "sidePanel",
      "alarms",
      "notifications"
    ],
    "omnibox": {
      "keyword": "solve"
    },
    "commands": {
      "solve-active-game": {
        "suggested_key": {
          "default": "Ctrl+Shift+S",
          "mac": "Command+Shift+S"
        },
        "description": "__MSG_commandSolveActiveGame__"
      },
      "get-single-hint": {
        "suggested_key": {
          "default": "Ctrl+Shift+H",
          "mac": "Command+Shift+H"
        },
        "description": "__MSG_commandGetSingleHint__"
      }
    }
  },
  "pnpm": {
    "overrides": {
      "date-fns": "3.6.0"
    },
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}

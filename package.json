{
  "name": "linkedin-games-solver",
  "displayName": "__MSG_extensionName__",
  "version": "0.0.5",
  "description": "__MSG_extensionDescription__",
  "alias": {
    "node:module": false,
    "node:fs": false,
    "node:path": false,
    "node:os": false
  },
  "author": "Muhammed Mustafa AKŞAM <info@muhammedaksam.com.tr>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "generate:store-assets": "node scripts/generate-store-assets.mjs"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.16.0",
    "plasmo": "0.90.5",
    "radix-ui": "^1.4.3",
    "react": "18.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "18.2.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "3.2.4",
    "puppeteer": "^25.0.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.3.3"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "default_locale": "en",

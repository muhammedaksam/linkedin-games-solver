# Google Analytics 4 (GA4) Telemetry Settings
WXT_GA_MEASUREMENT_ID=G-XXXXXXXXXX
WXT_GA_API_SECRET=your_ga4_measurement_protocol_api_secret_here

# Store Asset Sync Settings (Scripts)
CWS_CONSOLE_ID=your_chrome_webstore_console_id_here
CWS_ITEM_ID=your_chrome_webstore_item_id_here

# WXT Submit - Chrome Web Store Credentials
CHROME_EXTENSION_ID=your_chrome_extension_id_here
CHROME_CLIENT_ID=your_chrome_client_id_here
CHROME_CLIENT_SECRET=your_chrome_client_secret_here
CHROME_REFRESH_TOKEN=your_chrome_refresh_token_here

# WXT Submit - Firefox Add-on Store Credentials
FIREFOX_EXTENSION_ID=your_firefox_extension_id_here
FIREFOX_JWT_ISSUER=your_firefox_jwt_issuer_here
FIREFOX_JWT_SECRET=your_firefox_jwt_secret_here

# WXT Submit - Microsoft Edge Add-ons Credentials
EDGE_PRODUCT_ID=your_edge_product_id_here
EDGE_CLIENT_ID=your_edge_client_id_here
EDGE_API_KEY=your_edge_api_key_here

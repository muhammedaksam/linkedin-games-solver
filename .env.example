# Google Analytics 4 (GA4) Telemetry Settings
# Rename this file to .env.local for development / production builds

# GA4 Web Data Stream Measurement ID (e.g. G-XXXXXXXXXX)
PLASMO_PUBLIC_GTAG_ID=G-XXXXXXXXXX

# GA4 Measurement Protocol API Secret Key
# Generated in GA4 Admin -> Data Streams -> select Stream -> Measurement Protocol API secrets
PLASMO_PUBLIC_SECRET_API_KEY=your_ga4_measurement_protocol_api_secret_here

# Chrome Web Store Console & Item IDs for Semi-Automated Asset Uploads
CWS_CONSOLE_ID=your_chrome_webstore_console_id_here
CWS_ITEM_ID=your_chrome_webstore_item_id_here

# Edge Add-ons
EDGE_PRODUCT_ID=your_edge_product_id_here
